{
    "name": "Python Dev Container",
    "dockerFile": "Dockerfile",
    "context": ".",
    "runArgs": [
        "--env",
        "DEBIAN_FRONTEND=noninteractive"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            }
        }
    },
    "postCreateCommand": "pip install --upgrade pip && pip install flake8"
}